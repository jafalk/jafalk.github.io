# -FrontPage-

IndexIgnore .htaccess */.??* *~ *# */HEADER* */README* */_vti*

<Limit GET POST>
order deny,allow
deny from all
allow from all
</Limit>
<Limit PUT DELETE>
order deny,allow
deny from all
</Limit>

# === TILFØJET: tving HTTPS (http → https, 301) ===
# Kører før one.com's static-blok nedenfor, så alt — inkl. /consulting — går på https.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>
# === SLUT tilføjelse ===

<If " %{ENV:G1_RUNTIME} == 'static' ">
    <If " -d %{REQUEST_FILENAME} || %{REQUEST_FILENAME} =~ /.*\.php$/ ">
        Require all denied
    </If>
    <If " ! -f %{REQUEST_FILENAME} ">
        <IfModule mod_rewrite.c>
            RewriteEngine On
            RewriteRule .* - [R=404,L]
        </IfModule>
    </If>
</If>
